{
  "name": "frontend",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "generate:api": "openapi-ts -i http://127.0.0.1:8080/swagger-openapi.json -o app/composables/api -c @hey-api/client-fetch && pnpm run format",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,vue,js,mjs,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,vue,js,mjs,json,md}\"",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@nuxt/eslint": "1.15.2",
    "@nuxt/icon": "2.2.2",
    "@nuxt/image": "2.0.0",
    "@nuxt/test-utils": "4.0.3",
    "@nuxt/ui": "4.8.0",
    "@nuxtjs/mdc": "^0.22.0",
    "@pinia/nuxt": "0.11.3",
    "eslint": "^10.4.0",
    "nuxt": "^4.4.6",
    "pinia": "^3.0.4",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "valibot": "^1.4.0",
    "vue": "^3.5.34",
    "vue-router": "^5.0.7"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.97.2",
    "@iconify-json/material-symbols": "^1.2.73",
    "@nuxtjs/eslint-config-typescript": "^12.1.0",
    "@types/node": "^25.9.1",
    "@vue/test-utils": "^2.4.10",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "happy-dom": "^20.9.0",
    "prettier": "^3.8.3",
    "vitest": "^4.1.7"
  },
  "packageManager": "pnpm@11.2.2"
}
